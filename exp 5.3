clc;
clear;
close all;

%% --- Input Parameters ---
fp = 1000;          % High-pass cutoff frequency (Hz)
fs = 8000;          % Sampling frequency (Hz)
N  = 50;            % Filter order

% Normalized cutoff frequency (0 to 1)
wc = fp / (fs/2);

%% --- FIR High-Pass Filter using Hanning Window ---
window = hanning(N+1);

b_hann = fir1(N, wc, 'high', window);

%% --- Display Filter Coefficients ---
disp('--- High-Pass Coefficients (Hanning Window) ---');
disp(b_hann');

%% --- Frequency Response ---
figure;
freqz(b_hann, 1, 1024, fs);
title('High-Pass FIR Filter using Hanning Window');
grid on;

%% --- Magnitude Response ---
[H, F] = freqz(b_hann, 1, 1024, fs);

figure;
plot(F, abs(H));
xlabel('Frequency (Hz)');
ylabel('Magnitude');
title('Magnitude Response of High-Pass FIR Filter');
grid on;

%% --- Phase Response ---
figure;
plot(F, angle(H));
xlabel('Frequency (Hz)');
ylabel('Phase (Radians)');
title('Phase Response of High-Pass FIR Filter');
grid on;
